local SPEC = {
    ["Flashbang"]={fuse=1.7,floor=false},["HE Grenade"]={fuse=1.6,floor=false},
    ["Smoke Grenade"]={fuse=1.6,floor=false},["Decoy Grenade"]={fuse=1.6,floor=false},
    ["Molotov"]={fuse=nil,floor=true},["Incendiary Grenade"]={fuse=nil,floor=true},
}

local function nadeFuse(name)
    if not name then return 1.6, false end
    local low = string.lower(name)
    for k, v in pairs(SPEC) do
        if string.find(low, string.lower(k), 1, true) then
            local f = v.fuse
            if (O.NadeFuseOverride or 0) > 0 and not v.floor then
                f = O.NadeFuseOverride
            end
            return f, v.floor
        end
    end
    return 1.6, false
end

local function equippedNadeName()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    for _, ch in ipairs(cam:GetChildren()) do
        if ch:IsA("Model") then
            local low = string.lower(ch.Name)
            if low:find("nade") or low:find("grenade") or low:find("flash")
                or low:find("smoke") or low:find("molot")
                or low:find("incend") or low:find("decoy") or low:find("frag") then
                return ch.Name
            end
        end
    end
    return nil
end

local function simulate(origin, velocity, name, points, ignore)
    points = points or {}
    for i = #points, 1, -1 do points[i] = nil end
    local dt = 1/60
    local g = Vector3.new(0, -workspace.Gravity, 0)
    local el, sl = 0.42, 6
    local fuse, onFloor = nadeFuse(name)
    local pos, vel = origin, velocity
    local bounces, elapsed = 0, 0
    local si, st, sw
    points[1] = pos
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = ignore or {}
    for _ = 1, 420 do
        local nv = vel + g*dt
        local np = pos + nv*dt
        if fuse and elapsed >= fuse then
            si = #points st = elapsed sw = "FUSE" break
        end
        local hit = workspace:Raycast(pos, np-pos, rp)
        elapsed = elapsed + dt
        if hit then
            pos = hit.Position + hit.Normal*0.05
            points[#points+1] = pos
            if onFloor and hit.Normal.Y > 0.7 then
                si = #points st = elapsed sw = "FLOOR" break
            end
            vel = (nv - 2*nv:Dot(hit.Normal)*hit.Normal)*el
            bounces = bounces + 1
            if bounces > 4 then sw = "BOUNCES" break end
            if vel.Magnitude < sl and not fuse then sw = "REST" break end
        else
            pos, vel = np, nv
            points[#points+1] = pos
        end
    end
    if not si then si = #points st = elapsed sw = sw or "REST" end
    return points, si, st, sw
end

