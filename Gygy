function MV.Project(pos)
    local cam = workspace.CurrentCamera
    if not cam then return nil,false,0 end
    local p, on = cam:WorldToViewportPoint(pos)
    return Vector2.new(p.X,p.Y), on and p.Z>0, p.Z
end

function MV.IsEnemy(pl)
    local mine = LP:GetAttribute("Team")
    if mine and pl:GetAttribute("Team") == mine then return false end
    return true
end

function MV.IsInvul(model, pl)
    if model and model:GetAttribute("Invincible")==true then return true end
    if pl and pl:GetAttribute("Invincible")==true then return true end
    return false
end

local function espBounds(character, root)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local head = character:FindFirstChild("Head")
    if not head then return nil end
    local bottomY = root.Position.Y - math.max(root.Size.Y*1.45, 2.7)
    for _, name in ipairs({"LeftFoot","RightFoot","LeftLowerLeg","RightLowerLeg"}) do
        local part = character:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            bottomY = math.min(bottomY, part.Position.Y - part.Size.Y*0.5)
        end
    end
    local topWorld = head.Position + Vector3.new(0, head.Size.Y*0.55+0.12, 0)
    local bottomWorld = Vector3.new(root.Position.X, bottomY, root.Position.Z)
    local top, _, topZ = MV.Project(topWorld)
    local bottom, _, botZ = MV.Project(bottomWorld)
    if not top or not bottom or topZ<=0.05 or botZ<=0.05 then return nil end
    local topY, bottomY2 = math.min(top.Y,bottom.Y), math.max(top.Y,bottom.Y)
    local height = bottomY2 - topY
    if height < 7 then return nil end
    local centerX = (top.X + bottom.X)*0.5
    local width = height * 0.46
    local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    if torso and torso:IsA("BasePart") then
        local span = math.max(torso.Size.X*0.68, 0.85)
        local l, _, lZ = MV.Project(torso.Position - cam.CFrame.RightVector*span)
        local r, _, rZ = MV.Project(torso.Position + cam.CFrame.RightVector*span)
        if l and r and lZ>0 and rZ>0 then
            width = math.max(width, math.abs(r.X - l.X))
        end
    end
    local scale = math.clamp(O.EspBoxScale, 1, 1.5)
    local pad = height*(scale-1)*0.5
    topY = topY - pad
    bottomY2 = bottomY2 + pad
    height = height * scale
    width = math.clamp(width*scale, 6, math.max(6, height*0.78))
    local left, right = centerX-width*0.5, centerX+width*0.5
    local vp = cam.ViewportSize
    local onScreen = right>=0 and left<=vp.X and bottomY2>=0 and topY<=vp.Y
    return left, topY, right, bottomY2, onScreen, width, height, centerX, (topY+bottomY2)*0.5
end

