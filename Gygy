local function stepNumbers()
    for i=#numbers,1,-1 do
        local n = numbers[i]
        local age = (tick()-n.born)/O.DamageNumLife
        if age >= 1 then
            n.label:Destroy()
            numbers[i] = nil
        else
            local p, v, z = MV.Project(n.at + Vector3.new(0, age*3, 0))
            if p and v and z>0 then
                n.label.Position = UDim2.fromOffset(p.X, p.Y)
                n.label.TextTransparency = age
                n.label.Visible = true
            else
                n.label.Visible = false
            end
        end
    end
end

local fxLive, fxPool = {}, {}
local function fxPart()
    local p = table.remove(fxPool)
    if not p then
        p = Instance.new("Part")
        p.Anchored = true p.CanCollide = false p.CanQuery = false
        p.CanTouch = false p.CastShadow = false
        p.Material = Enum.Material.Neon
    end
    p.Parent = fxWorld
    p.Transparency = 0
    p.Shape = Enum.PartType.Block
    p.Size = Vector3.new(1,1,1)
    return p
end
local function fxAdd(part, life, style)
    fxLive[#fxLive+1] = {part=part, born=tick(), life=life, style=style}
    if #fxLive > 60 then
        local old = table.remove(fxLive, 1)
        if old.part then
            old.part.Parent = nil
            if #fxPool < 80 then fxPool[#fxPool+1] = old.part end
        end
    end
end

