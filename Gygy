    if O.NoFog then
        Lighting.FogEnd = 1e6
        Lighting.FogStart = 1e6
    end

    if O.NoSun then
        for _, r in ipairs(Lighting:GetChildren()) do
            if r:IsA("SunRaysEffect") then r.Enabled = false end
        end
    end

    if O.NoBlur then
        for _, b in ipairs(Lighting:GetChildren()) do
            if b:IsA("BlurEffect") then b.Enabled = false end
        end
    end

    if O.NoColorCorrection then
        for _, c in ipairs(Lighting:GetChildren()) do
            if c:IsA("ColorCorrectionEffect") then c.Enabled = false end
        end
    end

    if O.CustomFov then
        local cam = workspace.CurrentCamera
        if cam and LP:GetAttribute("IsSniperScoped") ~= true then
            cam.FieldOfView = O.CustomFovValue
        end
    end
end

local function stepSmoke(inst)
    if not O.NoSmoke then return end
    if not (inst:IsA("ParticleEmitter") or inst:IsA("Smoke")) then return end
    local owner = inst:FindFirstAncestorOfClass("Model") or inst.Parent
    local name = ((owner and owner.Name or "")..inst.Name):lower()
    if name:find("smoke") then inst.Enabled = false end
end

MV.Connect(workspace.DescendantAdded, stepSmoke)

local function stepAll()
    if MV.StepEsp then pcall(MV.StepEsp) end
    if MV.StepFx then pcall(MV.StepFx) end
    if MV.StepRadar then pcall(MV.StepRadar) end
    if MV.StepArc then pcall(MV.StepArc) end
    if MV.StepTrack then pcall(MV.StepTrack) end
    if MV.StepBombs then pcall(MV.StepBombs) end
    pcall(stepWorld)
end

MV.Connect(RunService.RenderStepped, stepAll)
local MV = _G.MarioVisuals
local O = MV.Options
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LP = Players.LocalPlayer
local RS = ReplicatedStorage

-- ============================================================
-- M namespace (Javor style)
-- ============================================================

MV.M = MV.M or {
    hookRestores = {},
    cleanModules = setmetatable({}, {__mode = "k"}),
    bulletHooked = false,
    bulletClass = nil,
    impactListenerReady = false,
    killListenerReady = false,
    tracerOriginOffset = 1.8,
}

local M = MV.M

-- ============================================================
-- Util (Javor style)
-- ============================================================

MV.Util = MV.Util or {}

function MV.Util.safeRequire(module)
    if not (module and module:IsA("ModuleScript")) then return false, nil end
    local ok, value = pcall(require, module)
    return ok, value
end

function MV.Util.registerModule(module, value)
    if not module or type(value) ~= "table" then return false end
    if M.cleanModules[module] == nil then
        M.cleanModules[module] = value
    end
    return true
end

function MV.Util.Hook(key, fn, replacement)
    if type(fn) ~= "function" or type(hookfunction) ~= "function" then
        return nil
    end
    if M[key] then
        return nil
    end
    local ok, original = pcall(hookfunction, fn, replacement)
    if not ok or type(original) ~= "function" then
        warn("[MV] hook "..key..":", ok and "executor returned no original" or original)
        return nil
    end
    M[key] = { Fn = fn, Original = original }
    return original
end

function MV.Util.UnhookAll()
    for key, hook in pairs(M) do
        if type(hook) == "table" and hook.Fn and hook.Original then
            pcall(function() hookfunction(hook.Fn, hook.Original) end)
        end
    end
end

-- ============================================================
-- GameLib resolver (Javor style)
-- ============================================================

MV.GameLib = MV.GameLib or {}

function MV.GameLib.Resolve(path, home)
    local node = RS
    for i, name in ipairs(path) do
        if i == #path and home then
            -- fallback: search by parent name
            local found = node:FindFirstChild(name)
            if found and found.Parent
                and found.Parent.Name == home then return found end
            for _, desc in ipairs(RS:GetDescendants()) do
                if desc.Name == name and desc.Parent
                    and desc.Parent.Name == home then return desc end
            end
        end
        node = node and node:FindFirstChild(name)
        if not node then return nil end
    end
    return node
end

function MV.GameLib.Remotes()
    return MV.GameLib.Resolve({"Database","Security","Remotes"}, "Security")
end

-- ============================================================
-- 1. BULLET HOOK (tracer) — Javor style
-- ============================================================

function MV.installBullet()
    if M.bulletHooked then return true end

    local bulletClass
    if type(getgc) == "function" then
        for _, obj in ipairs(getgc(true)) do
            if type(obj) == "table"
                and type(rawget(obj, "_performRaycast")) == "function"
                and rawget(obj, "getTrueSpread") ~= nil then
                bulletClass = obj
                break
            end
        end
    end

    if not bulletClass then
        local classes = RS:FindFirstChild("Classes")
        local bullet = classes and classes:FindFirstChild("Bullet")
        if bullet then
            local ok, mod = MV.Util.safeRequire(bullet)
            if ok and type(mod) == "table"
                and type(mod._performRaycast) == "function" then
                MV.Util.registerModule(bullet, mod)
                bulletClass = mod
            end
        end
    end

    if not bulletClass then return false end

    local hooked, _, _, _, restore = MV.hookMethod(bulletClass, "_performRaycast",
        function(original, ...)
            local returns = table.pack(original(...))
            local result = returns[1]
            if type(result) == "table" and O.Tracers then
                pcall(function()
                    local origin = rawget(result, "Origin")
                    if not origin and workspace.CurrentCamera then
                        origin = workspace.CurrentCamera.CFrame.Position
                    end
                    local targetPos
                    local hits = rawget(result, "Hits")
                    if type(hits) == "table" and #hits > 0
                        and hits[#hits] and hits[#hits].Position then
                        targetPos = hits[#hits].Position
                    elseif rawget(result, "Direction") and origin then
                        targetPos = origin + result.Direction
                            * (result.Distance or 500)
                    end
                    if origin and targetPos then
                        local d = targetPos - origin
                        if d.Magnitude > 0.05 then
                            local start = origin + d.Unit * M.tracerOriginOffset
                            MV.SpawnTracer(start, targetPos)
                        end
                    end
                end)
            end
            return table.unpack(returns, 1, returns.n)
        end)

    M.bulletHooked = hooked == true
    if restore then
        table.insert(M.hookRestores, restore)
    end
    return M.bulletHooked
end

-- универсальная обёртка над hookfunction без getgc
function MV.hookMethod(container, key, handler)
    local target = container and container[key]
    if type(target) ~= "function" then return false, nil end
    local original = target
    local live = true
    local replacement = function(...)
        if not live then return original(...) end
        return handler(original, ...)
    end

    local ok, previous = pcall(hookfunction, target, replacement)
    if ok and type(previous) == "function" and previous ~= replacement then
        original = previous
        local undo = function()
            if not live then return end
            live = false
            handler = nil
            pcall(hookfunction, target, previous)
        end
        return true, target, replacement, "function", undo
    end

    local direct = pcall(function() container[key] = replacement end)
    if direct and container[key] == replacement then
        local restore = function()
            if not live then return end
            live = false
            handler = nil
            pcall(function()
                if container[key] == replacement then container[key] = target end
            end)
        end
        return true, target, replacement, "direct", restore
    end

    return false, nil
end

-- ============================================================
-- 2. IMPACT LISTENER — Javor style
-- ============================================================

function MV.installImpactListener()
    if M.impactListenerReady then return true end
    local remotes = MV.GameLib.Remotes()
    if not remotes then return false end

    local vfx = remotes:FindFirstChild("VFX")
    local impact = vfx and vfx:FindFirstChild("CreateImpact")
    if not impact or type(impact.Listen) ~= "function" then return false end

    local ok, listener = pcall(impact.Listen, function(payload)
        if type(payload) ~= "table" then return end
        if tostring(payload.AttackerUserId or "") ~= tostring(LP.UserId) then
            return
        end
        if payload.Exit == true then return end

        local pos = typeof(payload.Position) == "Vector3"
            and payload.Position or nil
        if not pos then return end

        local head = payload.WasHelmetHeadshot == true
            or (payload.Instance and payload.Instance.Name == "Head")

        pcall(MV.HitMarker, pos)
        pcall(MV.HitFx, pos)
        pcall(MV.DamageNumber, head and "HEAD" or "-", pos, head)
    end)

    if ok then
        M.impactListenerReady = true
        M.impactListener = listener
    end
    return M.impactListenerReady
end

-- ============================================================
-- 3. KILL LISTENER — Javor style
-- ============================================================

function MV.installKillListener()
    if M.killListenerReady then return true end
    local remotes = MV.GameLib.Remotes()
    if not remotes then return false end

    local ui = remotes:FindFirstChild("UI")
    local killed = ui and ui:FindFirstChild("UIPlayerKilled")
    if not killed or type(killed.Listen) ~= "function" then return false end

    local lastSig, lastAt = nil, 0

    local ok, listener = pcall(killed.Listen, function(payload)
        if type(payload) ~= "table" then return end
        if tostring(payload.Killer or "") ~= tostring(LP.UserId) then return end

        local sig = tostring(payload.Killer)..":"
            ..tostring(payload.Victim)..":"
            ..tostring(payload.Weapon or "")
        local now = tick()
        if sig == lastSig and now - lastAt < 1 then return end
        lastSig, lastAt = sig, now

        local pos
        if typeof(payload.DeathPosition) == "Vector3" then
            pos = payload.DeathPosition
        else
            local vid = tonumber(payload.Victim)
            local victim = vid and Players:GetPlayerByUserId(vid)
            local char = victim and victim.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then pos = root.Position end
        end
        if pos then pcall(MV.KillFx, pos) end
    end)

    if ok then
        M.killListenerReady = true
        M.killListener = listener
    end
    return M.killListenerReady
end

-- ============================================================
-- 4. LAZY RETRY — устанавливаем хуки когда нужно
-- ============================================================

function MV.stepHooks()
    if O.Tracers and not M.bulletHooked then
        MV.installBullet()
    end
    if not M.impactListenerReady then
        MV.installImpactListener()
    end
    if not M.killListenerReady then
        MV.installKillListener()
    end
end

-- ============================================================
-- 5. UNHOOK при выключении
-- ============================================================

function MV.uninstallHooks()
    for _, restore in ipairs(M.hookRestores) do
        pcall(restore)
    end
    table.clear(M.hookRestores)
    if M.impactListener and type(M.impactListener.Disconnect) == "function" then
        pcall(function() M.impactListener:Disconnect() end)
    end
    if M.killListener and type(M.killListener.Disconnect) == "function" then
        pcall(function() M.killListener:Disconnect() end)
    end
    M.impactListenerReady = false
    M.killListenerReady = false
    M.bulletHooked = false
end

-- ============================================================
-- 6. ПОДКЛЮЧЕНИЕ К MAIN LOOP
-- ============================================================

game:GetService("RunService").Heartbeat:Connect(function()
    pcall(MV.stepHooks)
end)

