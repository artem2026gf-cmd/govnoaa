function MV.Slider(key, label, minV, maxV, step, unit)
    local r = row(key, label)
    local tr = MV.Mk("Frame", r, {
        Size = UDim2.new(1,-300,0,6), Position = UDim2.fromOffset(206,14),
        BackgroundColor3 = C.bg, BackgroundTransparency = 0.25, BorderSizePixel = 0,
    })
    MV.Mk("UICorner", tr, { CornerRadius = UDim.new(1,0) })
    local fl = MV.Mk("Frame", tr, { Size = UDim2.fromScale(0,1), BackgroundColor3 = C.ac, BorderSizePixel = 0 })
    MV.Mk("UICorner", fl, { CornerRadius = UDim.new(1,0) })
    local kn = MV.Mk("Frame", tr, {
        Size = UDim2.fromOffset(14,14), AnchorPoint = Vector2.new(0.5,0.5),
        Position = UDim2.new(0,0,0.5,0), BackgroundColor3 = C.ht, BorderSizePixel = 0,
    })
    MV.Mk("UICorner", kn, { CornerRadius = UDim.new(1,0) })
    local vl = MV.Mk("TextLabel", r, {
        Size = UDim2.fromOffset(72,34), Position = UDim2.new(1,-88,0,0),
        BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
        TextSize = 13, TextColor3 = C.ac, TextXAlignment = Enum.TextXAlignment.Right,
    })
    local function place()
        local v = tonumber(O[key]) or minV
        local a = math.clamp((v-minV)/math.max(maxV-minV,1e-6), 0, 1)
        fl.Size = UDim2.fromScale(a,1)
        kn.Position = UDim2.new(a,0,0.5,0)
        local t
        if step >= 1 then t = string.format("%d", v)
        elseif step >= 0.1 then t = string.format("%.1f", v)
        else t = string.format("%.2f", v) end
        vl.Text = t..(unit or "")
    end
    local dr = MV.Mk("TextButton", r, {
        Size = UDim2.new(1,-288,0,26), Position = UDim2.fromOffset(198,4),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
    })
    local act = false
    local function setX(x)
        local l = tr.AbsolutePosition.X
        local w = math.max(tr.AbsoluteSize.X, 1)
        local a = math.clamp((x-l)/w, 0, 1)
        local raw = minV + a*(maxV-minV)
        local sn = minV + math.floor((raw-minV)/step + 0.5)*step
        O[key] = math.clamp(sn, minV, maxV)
        place()
    end
    dr.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
            or i.UserInputType == Enum.UserInputType.Touch then
            act = true
            setX(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if act and i.UserInputType == Enum.UserInputType.MouseMovement then setX(i.Position.X) end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then act = false end
    end)
    place()
end

